{
  "name": "survival",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build wasm --target web --release --out-dir pkg",
    "wasm:dev": "wasm-pack build wasm --target web --dev --out-dir pkg",
    "dev": "pnpm wasm:dev && vite",
    "build": "pnpm wasm && tsc -b && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path wasm/Cargo.toml"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
