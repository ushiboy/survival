{
  "name": "survival",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build wasm --target web --release --out-dir pkg",
    "wasm:dev": "wasm-pack build wasm --target web --dev --out-dir pkg",
    "dev": "pnpm wasm:dev && vite",
    "build": "pnpm wasm && tsc -b && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path wasm/Cargo.toml",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "fmt": "cargo fmt --manifest-path wasm/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path wasm/Cargo.toml --check",
    "map": "cargo run -q --profile tools --manifest-path wasm/Cargo.toml --example map --",
    "map:watch": "node scripts/map-watch.mjs",
    "art": "cargo run -q --profile tools --manifest-path wasm/Cargo.toml --example art --",
    "art:watch": "node scripts/art-watch.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-intl": "^4.15.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
